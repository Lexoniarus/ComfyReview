# App
COMFYREVIEW_HOST=127.0.0.1
COMFYREVIEW_PORT=8000

# Copy this file to .env for persistent local settings.

# Paths
# Windows example:
# COMFYREVIEW_OUTPUT_ROOT=C:\\Users\\<YOU>\\PycharmProjects\\ComfyUI\\output
COMFYREVIEW_OUTPUT_ROOT=
COMFYREVIEW_DATA_DIR=

# Canonical runtime database (optional override)
COMFYREVIEW_DATABASE=

# Read-only Card Battler model database (optional override)
# Defaults to <COMFYREVIEW_DATA_DIR>/card_battler.sqlite3
COMFYREVIEW_CARD_BATTLER_MODEL_DATABASE=

# Offline migration overrides. These are loaded through LegacyMigrationSettings
# only; normal application runtime does not depend on these databases.
COMFYREVIEW_RATINGS_DB=
COMFYREVIEW_PROMPT_TOKENS_DB=
COMFYREVIEW_ARENA_DB=
COMFYREVIEW_PLAYGROUND_DB=
COMFYREVIEW_COMBO_DB=
COMFYREVIEW_IMAGES_DB=
COMFYREVIEW_PROMPT_RATINGS_DB=

# ComfyUI
COMFYREVIEW_COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYREVIEW_WORKFLOWS_DIR=

# LM Studio (optional; normal startup does not require the server or models)
COMFYREVIEW_LM_STUDIO_BASE_URL=http://127.0.0.1:1234
COMFYREVIEW_LM_STUDIO_VISION_MODEL=
COMFYREVIEW_LM_STUDIO_TEXT_MODEL=
COMFYREVIEW_LM_STUDIO_REQUEST_TIMEOUT_SECONDS=120
COMFYREVIEW_LM_STUDIO_LIFECYCLE_TIMEOUT_SECONDS=180

# SSL
COMFYREVIEW_SSL_ENABLED=false
COMFYREVIEW_SSL_CERTFILE=
COMFYREVIEW_SSL_KEYFILE=
